<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
	<ItemGroup>
		<!-- CQRS / Mediator pattern -->
		<PackageVersion Include="MediatR" Version="12.5.0" />

		<!-- Validation with DI registration -->
		<PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

		<!-- Lightweight ORM for raw SQL queries -->
		<PackageVersion Include="Dapper" Version="2.1.72" />

		<!-- Fake data generation for testing -->
		<PackageVersion Include="Bogus" Version="35.6.5" />

		<!-- JWT authentication -->
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.14" />

		<!-- ASP.NET Core HTTP abstractions -->
		<PackageVersion Include="Microsoft.AspNetCore.Http.Features" Version="2.3.0" />

		<!-- ASP.NET Core Identity -->
		<PackageVersion Include="Microsoft.AspNetCore.Identity" Version="2.3.9" />

		<!-- Identity + Entity Framework integration -->
		<PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.14" />

		<!-- OpenAPI support -->
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.1" />

		<!-- Swagger UI & OpenAPI documentation -->
		<PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.5" />

		<!-- Entity Framework Core -->
		<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.14" />

		<!-- EF Core design-time tools (migrations/scaffolding) -->
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.14" />

		<!-- EF Core CLI tools -->
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.14" />

		<!-- PostgreSQL provider for EF Core -->
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />

		<!-- OpenTelemetry instrumentation for PostgreSQL -->
		<PackageVersion Include="Npgsql.OpenTelemetry" Version="9.0.4" />

		<!-- EF naming conventions (snake_case, etc.) -->
		<PackageVersion Include="EFCore.NamingConventions" Version="9.0.0" />

		<!-- Hangfire ASP.NET Core integration -->
		<PackageVersion Include="Hangfire.AspNetCore" Version="1.8.23" />

		<!-- Hangfire PostgreSQL storage provider -->
		<PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
		
		<!-- Redis distributed caching -->
		<PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.14" />

		<!-- Dependency injection abstractions -->
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.14" />

		<!-- Logging abstractions -->
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.14" />

		<!-- Configuration binding for Options pattern -->
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.14" />

		<!-- SMTP / IMAP email client -->
		<PackageVersion Include="MailKit" Version="4.16.0" />

		<!-- Elasticsearch .NET client -->
		<PackageVersion Include="NEST" Version="7.17.5" />

		<!-- Structured logging -->
		<PackageVersion Include="Serilog" Version="4.3.1" />

		<!-- ASP.NET Core integration for Serilog -->
		<PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />

		<!-- Seq sink for centralized log collection -->
		<PackageVersion Include="Serilog.Sinks.Seq" Version="9.0.0" />

		<!-- OpenTelemetry exporter (OTLP) -->
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />

		<!-- OpenTelemetry hosting extensions -->
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />

		<!-- ASP.NET Core tracing -->
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />

		<!-- Outgoing HTTP request tracing -->
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />

		<!-- Runtime metrics collection -->
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />

		<!-- Docker Engine API client -->
		<PackageVersion Include="Docker.DotNet" Version="3.125.15" />

		<!-- Visual Studio container tooling -->
		<PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets"
						Version="1.22.1" />

		<!-- Static code analysis -->
		<PackageVersion Include="SonarAnalyzer.CSharp"
						Version="10.6.0.109712" />

	</ItemGroup>
</Project>